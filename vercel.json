
{
  "version": 2,
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "installCommand": "npm ci",
  "buildCommand": "npm run build && (php -v >/dev/null 2>&1 && php artisan event:cache && php artisan route:cache && php artisan view:cache || echo 'Skipping artisan cache')",
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*\\.(?:css|js|mjs|png|jpg|jpeg|webp|gif|svg|ico|woff|woff2|ttf|eot|avif|json|txt|xml|map))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}