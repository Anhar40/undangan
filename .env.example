APP_NAME="Undangan Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (primary). Use DATABASE_URL in production/Vercel (Neon, Supabase, etc.).
DB_CONNECTION=pgsql
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=undangan_digital
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# DB_SCHEMA=public

# Cloudinary (primary media storage). Set CLOUDINARY_URL in production/Vercel.
CLOUDINARY_URL=
# Optional split vars if not using CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=
CLOUDINARY_SECURE=true

# Google OAuth (Authorized redirect URI: APP_URL/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Midtrans Core API — SERVER KEY MUST NEVER be exposed to the browser
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_NOTIFICATION_URL="${APP_URL}/payment/notification"
# Metode pilihan customer: qris, bca_va, bni_va, bri_va, permata_va, echannel, gopay, cstore
MIDTRANS_PAYMENT_TYPE=qris
MIDTRANS_EXPIRY_MINUTES=30
# Waktu respons gateway adalah WIB (GMT+7); timezone aplikasi tetap Asia/Makassar.
MIDTRANS_TIMESTAMP_TIMEZONE=Asia/Jakarta

# Invitation domain
PREVIEW_HOURS=10
ACTIVATION_PRICE=150000
UPLOAD_MAX_KB=2048
UPLOAD_MAX_DIMENSION=1600

# Serverless-friendly defaults. For Vercel, prefer database/cookie + sync or managed queue.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=cloudinary
QUEUE_CONNECTION=sync
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
